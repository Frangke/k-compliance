# K-Compliance environment file — copy to .env and fill in secrets.
# IMPORTANT: chmod 600 .env after creating it. Never commit the real .env.
#
# For the PostgreSQL password, prefer ~/.pgpass (chmod 600) so the plaintext
# password is not present in this file:
#   ~/.pgpass line:  localhost:5432:kcompliance:kcompliance:<password>
# Then DATABASE_URL can omit the password entirely (see examples below).

# ─── Database ────────────────────────────────────────────────────────────
# With ~/.pgpass (recommended — no password in file):
DATABASE_URL=postgresql+asyncpg://kcompliance@localhost:5432/kcompliance
DATABASE_URL_SYNC=postgresql://kcompliance@localhost:5432/kcompliance
# Or inline (discouraged — readable by anyone who reads this file):
# DATABASE_URL=postgresql+asyncpg://kcompliance:CHANGE_ME@localhost:5432/kcompliance
# DATABASE_URL_SYNC=postgresql://kcompliance:CHANGE_ME@localhost:5432/kcompliance

# ─── JWT (server signs access + refresh tokens) ──────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Password policy (ISMS-P 2.5.4) ──────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true
PASSWORD_HISTORY_COUNT=3

# ─── Account lockout (ISMS-P 2.5.3) ──────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ─── Session idle timeout ────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_MINUTES=30

# ─── S3 (evidence storage; local fallback uses uploads/ if bucket absent) ─
S3_BUCKET_NAME=k-compliance-evidence-dev
S3_REGION=ap-northeast-2

# ─── AES-256-GCM master key for cloud_accounts credentials ───────────────
# REQUIRED: 256-bit random value. Generate exactly with:
#     openssl rand -hex 32
# Do NOT substitute a human-memorable passphrase. No KDF (PBKDF2/Argon2)
# is applied — the code assumes this value is already high-entropy
# Rotating this key renders previously encrypted credentials unreadable —
# you'll need to re-enter them in the Cloud Accounts page.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ─── Prowler ─────────────────────────────────────────────────────────────
PROWLER_BIN_PATH=prowler
PROWLER_OUTPUT_DIR=/tmp/prowler-scans

# ─── App environment ─────────────────────────────────────────────────────
# development → /api/admin/reset-data and sample data endpoints enabled.
# any other value → they return 403.
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
